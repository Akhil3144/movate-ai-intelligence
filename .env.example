# Optional; discovery also checks Downloads/Desktop and project/data.
MOVATE_DATA_ZIP=
MOVATE_WORKBOOK_DIR=
# disabled | openai | ollama. No model is selected implicitly.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Vercel only: configure in project Environment Variables, never VITE_ variables.
# Required in every hosted environment; password must contain at least 24 characters.
MOVATE_DEMO_USERNAME=
MOVATE_DEMO_PASSWORD=
